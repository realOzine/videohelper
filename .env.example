# Local development credentials; load explicitly with: set -a; source .env; set +a
VH_DB_URL=postgres://videohelper:videohelper-local@127.0.0.1:55432/videohelper?sslmode=disable
VH_REDIS_ADDR=127.0.0.1:56379
VH_ML_TOKEN=videohelper-local-model-token
ML_INTERNAL_TOKEN=videohelper-local-model-token
ML_S3_ENDPOINT=http://127.0.0.1:59000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=videohelper-local
AWS_SECRET_ACCESS_KEY=videohelper-local-secret
AWS_EC2_METADATA_DISABLED=true
ML_CACHE_DIR=/tmp/videohelper-ml-cache
